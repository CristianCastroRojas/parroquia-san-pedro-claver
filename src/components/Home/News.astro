---
/**
 * Sección de noticias parroquiales.
 *
 * Las noticias se gestionan desde un arreglo para evitar
 * repetir la estructura HTML y facilitar su crecimiento.
 *
 * Cada noticia contiene la información necesaria para mostrar
 * su categoría, fecha, título, descripción, imagen y enlace.
 */

import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";

/**
 * Lista de noticias mostradas en la página de inicio.
 *
 * Cada elemento representa una publicación parroquial
 * y contiene la información utilizada para construir
 * dinámicamente las tarjetas de noticias.
 */
const noticias = [
  {
    categoria: "Espiritualidad",
    fecha: "18 May. 2026",
    titulo: "Jornada de confesiones: un reencuentro con la misericordia",
    descripcion:
      "Más de 300 feligreses se acercaron al sacramento de la Reconciliación en una jornada preparada para Pentecostés.",
    imagen:
      "https://images.unsplash.com/photo-1553906451-86e5710d388e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxwcmllc3QlMjBibGVzc2luZyUyMHBlb3BsZSUyMHdhcm18ZW58MXx8fHwxNzc4ODEzMDcxfDA&ixlib=rb-4.1.0&q=80&w=800",
    alt: "Jornada de confesiones comunitarias",
    enlace: "/blog/confesiones-comunitarias-pentecostes",
  },
  {
    categoria: "Comunidad",
    fecha: "10 May. 2026",
    titulo: "Éxito total en el bazar juvenil pro-misiones",
    descripcion:
      "Agradecemos a toda la comunidad. Recaudamos más del doble de la meta para apoyar las misiones.",
    imagen:
      "https://images.unsplash.com/photo-1511632765486-a01980e01a18?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHx5b3V0aCUyMGdyb3VwJTIwY29tbXVuaXR5JTIwaGFwcHl8ZW58MXx8fHwxNzc4ODEzMDcyfDA&ixlib=rb-4.1.0&q=80&w=800",
    alt: "Bazar juvenil pro-misiones",
    enlace: "/blog/exito-bazar-juvenil-pro-misiones",
  },
  {
    categoria: "Parroquia",
    fecha: "05 May. 2026",
    titulo: "Restauración de la fachada del templo",
    descripcion:
      "Conoce los avances de la obra de mantenimiento que embellecerá nuestra casa espiritual.",
    imagen:
      "https://images.unsplash.com/photo-1698822079732-501a7e06860f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjYXRob2xpYyUyMGNodXJjaCUyMGNyb3NzJTIwZWxlZ2FudHxlbnwxfHx8fDE3Nzg4MTMwNzF8MA&ixlib=rb-4.1.0&q=80&w=800",
    alt: "Restauración de la fachada del templo",
    enlace: "/blog/restauracion-fachada-templo",
  },
];
---

<section
  aria-labelledby="noticias-titulo"
  class="bg-secondary py-16 text-foreground lg:py-20"
>
  <div class="mx-auto max-w-7xl px-6">
    <!-- Encabezado de la sección -->
    <header
      class="mb-10 flex flex-col gap-6 md:mb-12 md:flex-row md:items-end md:justify-between"
    >
      <div class="max-w-2xl">
        <span
          class="text-sm font-medium uppercase tracking-wider text-foreground/70"
        >
          Actualidad
        </span>

        <!-- Título de la sección -->
        <h2
          id="noticias-titulo"
          class="mt-2 font-display text-4xl font-medium leading-tight text-foreground md:text-5xl"
        >
          Noticias parroquiales
        </h2>

        <!-- Descripción de la sección -->
        <p class="mt-4 max-w-xl text-base leading-relaxed text-foreground/75">
          Conoce las noticias, acontecimientos y momentos que hacen parte de la
          vida de nuestra comunidad parroquial.
        </p>
      </div>

      <!-- Enlace hacia todas las noticias -->
      <a
        href="/blog"
        aria-label="Ver todas las noticias parroquiales"
        class="group inline-flex shrink-0 items-center gap-2 font-medium text-foreground transition-colors hover:text-foreground/70"
      >
        Ver todas

        <ArrowRight
          size={18}
          aria-hidden="true"
          class="transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </header>

    <!-- Lista de noticias -->
    <div
      class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
      role="list"
    >
      {
        noticias.map((noticia) => (
          <a
            href={noticia.enlace}
            role="listitem"
            class="group flex flex-col overflow-hidden rounded-2xl border border-foreground/10 bg-background shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
          >
            <!-- Imagen de la noticia -->
            <div class="relative aspect-16/10 overflow-hidden">
              <Image
                src={noticia.imagen}
                alt={noticia.alt}
                width={800}
                height={500}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />

              <!-- Capa de contraste sobre la imagen -->
              <div
                class="absolute inset-0 bg-linear-to-t from-foreground/40 to-transparent"
                aria-hidden="true"
              >
              </div>
            </div>

            <!-- Información de la noticia -->
            <div class="flex flex-1 flex-col p-6">
              <!-- Categoría y fecha de publicación -->
              <div class="mb-3 flex flex-wrap items-center gap-3">
                <span
                  class="rounded-full bg-secondary/20 px-3 py-1 text-xs font-medium text-foreground"
                >
                  {noticia.categoria}
                </span>

                <span class="text-xs font-medium text-foreground/60">
                  {noticia.fecha}
                </span>
              </div>

              <!-- Título de la noticia -->
              <h3
                class="font-display text-xl font-medium leading-snug text-foreground transition-colors group-hover:text-secondary"
              >
                {noticia.titulo}
              </h3>

              <!-- Resumen de la noticia -->
              <p
                class="mt-2 line-clamp-3 text-sm leading-relaxed text-foreground/70"
              >
                {noticia.descripcion}
              </p>

              <!-- Acción posicionada al final de la tarjeta -->
              <span
                class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-medium text-foreground transition-all group-hover:gap-2"
              >
                Leer más
                <ArrowRight size={16} aria-hidden="true" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

