---
/**
 * Botón flotante de WhatsApp.
 *
 * Proporciona un acceso directo al canal de comunicación
 * de WhatsApp de la Parroquia San Pedro Claver.
 *
 * El enlace se construye dinámicamente a partir del número
 * telefónico y del mensaje configurados en {@link CONTENT}.
 *
 * El botón permanece fijo en la parte inferior de la pantalla
 * y abre WhatsApp en una nueva pestaña.
 */

import { Icon } from "astro-icon/components";

import { CONTENT } from "@/constants/content";

/**
 * Número telefónico utilizado para generar el enlace de WhatsApp.
 *
 * Se eliminan los espacios del número configurado para garantizar
 * el formato requerido por la URL de WhatsApp.
 */
const whatsappNumber = CONTENT.contacto.telefono.replace(/\s/g, "");

/**
 * URL de acceso directo a WhatsApp.
 *
 * Incluye el código de país de Colombia (57) y un mensaje inicial
 * previamente configurado para facilitar el contacto con la parroquia.
 */
const whatsappUrl = `https://wa.me/57${whatsappNumber}?text=${encodeURIComponent(
  CONTENT.whatsapp.mensaje,
)}`;
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={CONTENT.whatsapp.etiqueta}
  class="group fixed right-6 bottom-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-[#25D366] focus:ring-offset-2"
>
  <Icon name="simple-icons:whatsapp" size={32} aria-hidden="true" />

  <span
    class="pointer-events-none absolute right-full mr-4 whitespace-nowrap rounded-xl bg-white px-3 py-1.5 text-sm font-medium text-foreground opacity-0 shadow-lg transition-opacity group-hover:opacity-100"
  >
    {CONTENT.whatsapp.etiqueta}
  </span>
</a>
