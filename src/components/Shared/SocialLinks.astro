---
/**
 * Enlaces a las redes sociales oficiales.
 *
 * Las redes sociales se configuran directamente en este componente.
 */

import { Icon } from "astro-icon/components";

const SOCIAL_LINKS = [
  {
    name: "Facebook",
    url: "#",
    icon: "simple-icons:facebook",
  },
  {
    name: "Instagram",
    url: "#",
    icon: "simple-icons:instagram",
  },
  {
    name: "YouTube",
    url: "#",
    icon: "simple-icons:youtube",
  },
] as const;
---

<div class="flex gap-4" aria-label="Redes sociales">
  {
    SOCIAL_LINKS.map((social) => (
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={social.name}
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-background/10 transition-colors hover:bg-primary hover:text-foreground"
      >
        <Icon name={social.icon} size={20} aria-hidden="true" />
      </a>
    ))
  }
</div>
