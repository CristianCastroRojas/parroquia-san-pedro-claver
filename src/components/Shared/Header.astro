---
/**
 * Header principal del sitio web.
 *
 * Contiene la identidad de la parroquia, la navegación principal
 * y el menú de navegación para dispositivos móviles.
 *
 * El menú móvil se controla mediante eventos del navegador,
 * permitiendo su apertura, cierre y navegación mediante teclado.
 */

import { Menu, X } from "@lucide/astro";

import Cross from "@/assets/icons/cross.svg";

import { HOME_ROUTE } from "@/constants/navigation";

import Navbar from "./Navbar.astro";

/**
 * Información utilizada en el encabezado.
 */
const HEADER_CONTENT = {
  shortName: "San Pedro Claver",
  type: "Parroquia",
} as const;
---

<!-- Encabezado principal -->
<header class="fixed top-0 z-50 h-20 w-full bg-background shadow-sm">
  <div class="mx-auto flex h-full max-w-7xl items-center justify-between px-6">
    <!-- Identidad institucional y enlace a la página de inicio -->
    <a
      href={HOME_ROUTE}
      class="group flex min-w-0 items-center gap-3"
      aria-label={`${HEADER_CONTENT.shortName} - Inicio`}
    >
      <div
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-foreground shadow-sm transition-transform group-hover:scale-105"
      >
        <Cross width="24" height="24" aria-hidden="true" />
      </div>

      <div class="flex min-w-0 flex-col text-foreground">
        <span
          class="truncate font-display text-lg font-bold leading-none tracking-wide"
        >
          {HEADER_CONTENT.shortName}
        </span>

        <span class="text-xs font-medium uppercase tracking-widest opacity-80">
          {HEADER_CONTENT.type}
        </span>
      </div>
    </a>

    <!-- Navegación principal para dispositivos de escritorio -->
    <Navbar />

    <!-- Botón para abrir el menú de navegación móvil -->
    <button
      id="menu-button"
      type="button"
      class="shrink-0 p-2 text-foreground lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu size={24} stroke-width={2.5} aria-hidden="true" />
    </button>
  </div>
</header>

<!-- Menú de navegación móvil -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-60 flex min-h-0 translate-x-full flex-col bg-background opacity-0 transition-[transform,opacity] duration-300 ease-out lg:hidden"
  aria-hidden="true"
>
  <!-- Botón para cerrar el menú -->
  <div class="flex justify-end p-6">
    <button
      id="close-menu"
      type="button"
      class="p-2 text-foreground"
      aria-label="Cerrar menú"
    >
      <X size={32} stroke-width={2.5} aria-hidden="true" />
    </button>
  </div>

  <!-- Navegación adaptada a dispositivos móviles -->
  <Navbar mobile />
</div>

<script>
  /**
   * Referencia al botón utilizado para abrir el menú móvil.
   */
  const menuButton = document.querySelector<HTMLButtonElement>("#menu-button");

  /**
   * Referencia al botón utilizado para cerrar el menú móvil.
   */
  const closeButton = document.querySelector<HTMLButtonElement>("#close-menu");

  /**
   * Referencia al contenedor principal del menú móvil.
   */
  const mobileMenu = document.querySelector<HTMLDivElement>("#mobile-menu");

  if (menuButton && closeButton && mobileMenu) {
    /**
     * Abre el menú móvil y actualiza su estado visual y accesible.
     *
     * También bloquea el desplazamiento del contenido de fondo
     * mientras el menú permanece abierto.
     */
    const openMenu = () => {
      mobileMenu.classList.remove("translate-x-full", "opacity-0");
      mobileMenu.classList.add("translate-x-0", "opacity-100");

      mobileMenu.setAttribute("aria-hidden", "false");
      menuButton.setAttribute("aria-expanded", "true");

      document.body.style.overflow = "hidden";
    };

    /**
     * Cierra el menú móvil y restaura su estado inicial.
     *
     * También habilita nuevamente el desplazamiento del contenido
     * principal de la página.
     */
    const closeMenu = () => {
      mobileMenu.classList.remove("translate-x-0", "opacity-100");
      mobileMenu.classList.add("translate-x-full", "opacity-0");

      mobileMenu.setAttribute("aria-hidden", "true");
      menuButton.setAttribute("aria-expanded", "false");

      document.body.style.overflow = "";
    };

    // Registra el evento de apertura del menú.
    menuButton.addEventListener("click", openMenu);

    // Registra el evento de cierre del menú.
    closeButton.addEventListener("click", closeMenu);

    // Cierra el menú al seleccionar cualquier enlace de navegación.
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    /**
     * Permite cerrar el menú mediante la tecla Escape.
     */
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
      }
    });
  }
</script>
