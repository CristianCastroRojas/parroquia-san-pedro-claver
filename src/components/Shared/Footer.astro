---
/**
 * Footer principal del sitio web.
 *
 * Contiene la información institucional de la parroquia,
 * enlaces de navegación, datos de contacto, redes sociales
 * y enlaces legales.
 *
 * La información se organiza directamente en este componente
 * cuando únicamente se utiliza en el pie de página.
 */

import { MapPin, Phone, Mail } from "@lucide/astro";

import Cross from "@/assets/icons/cross.svg";

import { HOME_ROUTE, NAVIGATION_ROUTES } from "@/constants/navigation";

import SocialLinks from "./SocialLinks.astro";

/**
 * Información utilizada exclusivamente en el pie de página.
 */
const FOOTER_CONTENT = {
  shortName: "San Pedro Claver",
  fullName: "Parroquia San Pedro Claver",
  type: "Parroquia",
  description:
    "Una comunidad viva que camina en la fe, la esperanza y la caridad. Bienvenidos a tu casa espiritual.",
  contact: {
    address: "Calle 17 #17-62, barrio Vallesther",
    phone: "323 253 5901",
    email: "parroquia.sanpedroclaver@diocesisdecucuta.com",
  },
  legal: {
    privacy: "Política de Privacidad",
    terms: "Términos de Uso",
  },
  development: {
    developer: "Cristian Andres Castro Rojas",
    donor: "Familia Castro Palacio",
  },
} as const;
---

<footer
  class="rounded-t-[3rem] bg-foreground pt-20 pb-10 text-background filter-none backdrop-filter-none"
>
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-6 md:grid-cols-4">
    <!-- Marca -->
    <div class="col-span-1 space-y-6 md:col-span-2">
      <a
        href={HOME_ROUTE}
        class="group flex min-w-0 items-center gap-3"
        aria-label={`${FOOTER_CONTENT.shortName} - Inicio`}
      >
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-foreground shadow-sm transition-[box-shadow,background-color] duration-300 group-hover:bg-primary/90 group-hover:shadow-md"
        >
          <Cross width="24" height="24" aria-hidden="true" class="shrink-0" />
        </div>

        <div class="flex min-w-0 flex-col text-background">
          <span
            class="truncate font-display text-xl font-bold leading-none tracking-wide"
          >
            {FOOTER_CONTENT.shortName}
          </span>

          <span
            class="mt-1 text-xs font-medium uppercase tracking-widest text-primary"
          >
            {FOOTER_CONTENT.type}
          </span>
        </div>
      </a>

      <!-- Descripción institucional de la parroquia -->
      <p class="max-w-sm font-light leading-relaxed text-background/70">
        {FOOTER_CONTENT.description}
      </p>

      <!-- Enlaces a las redes sociales oficiales -->
      <SocialLinks />
    </div>

    <!-- Enlaces de navegación -->
    <div class="space-y-6">
      <h4 class="font-display text-lg text-background">Enlaces</h4>

      <ul class="space-y-3 font-light text-background/80">
        {
          NAVIGATION_ROUTES.map((link) => (
            <li>
              <a href={link.path} class="transition-colors hover:text-primary">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Información de contacto -->
    <div class="min-w-0 space-y-6">
      <h4 class="font-display text-lg text-background">Contacto</h4>

      <ul class="space-y-4 font-light text-background/80">
        <!-- Dirección física -->
        <li class="flex min-w-0 items-start gap-3">
          <MapPin
            size={20}
            class="mt-0.5 shrink-0 text-primary"
            aria-hidden="true"
          />

          <span class="min-w-0 wrap-break-words">
            {FOOTER_CONTENT.contact.address}
          </span>
        </li>

        <!-- Número telefónico -->
        <li class="flex items-center gap-3">
          <Phone size={20} class="shrink-0 text-primary" aria-hidden="true" />

          <a
            href={`tel:${FOOTER_CONTENT.contact.phone.replace(/\s/g, "")}`}
            class="transition-colors hover:text-primary"
          >
            {FOOTER_CONTENT.contact.phone}
          </a>
        </li>

        <!-- Correo electrónico -->
        <li class="flex min-w-0 items-center gap-3">
          <Mail size={20} class="shrink-0 text-primary" aria-hidden="true" />

          <a
            href={`mailto:${FOOTER_CONTENT.contact.email}`}
            class="min-w-0 break-all transition-colors hover:text-primary"
          >
            {FOOTER_CONTENT.contact.email}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Información legal y derechos de autor -->
  <div
    class="mx-auto mt-16 flex max-w-7xl flex-col items-center justify-between gap-4 border-t border-background/10 px-6 pt-8 text-sm font-light text-background/50 md:flex-row"
  >
    <p>
      © {new Date().getFullYear()}{" "}
      {FOOTER_CONTENT.fullName}. Todos los derechos reservados.
    </p>

    <!-- Enlaces a documentos legales -->
    <div class="flex flex-wrap justify-center gap-6 md:justify-end">
      <a href="#" class="transition-colors hover:text-background">
        {FOOTER_CONTENT.legal.privacy}
      </a>

      <a href="#" class="transition-colors hover:text-background">
        {FOOTER_CONTENT.legal.terms}
      </a>
    </div>
  </div>

  <!-- Reconocimiento del desarrollo y donación -->
  <p class="mt-6 text-center text-xs font-light text-background/40">
    Desarrollado por{" "}
    <span class="text-background/60">
      {FOOTER_CONTENT.development.developer}
    </span>{" "}
    · Donación de la{" "}
    <span class="text-background/60">
      {FOOTER_CONTENT.development.donor}
    </span>
  </p>
</footer>
