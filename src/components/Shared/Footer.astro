---
/**
 * Footer principal del sitio web.
 *
 * Contiene la información institucional, enlaces de navegación,
 * datos de contacto, redes sociales y enlaces legales.
 */

import { MapPin, Phone, Mail } from "@lucide/astro";
import { Icon } from "astro-icon/components";

import Cross from "@/assets/icons/cross.svg";

import { CONTENT } from "@/constants/content";
import { RUTAS_NAVEGACION } from "@/constants/navigation";
---

<footer
  class="mt-12 rounded-t-[3rem] bg-foreground pt-20 pb-10 text-background"
>
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-6 md:grid-cols-4">
    <!-- Marca -->
    <div class="col-span-1 space-y-6 md:col-span-2">
      <div class="flex items-center gap-3">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-foreground"
        >
          <Cross width="24" height="24" aria-hidden="true" />
        </div>

        <div class="flex min-w-0 flex-col">
          <span
            class="font-display text-xl font-bold leading-none tracking-wide text-background"
          >
            {CONTENT.encabezado.nombreCorto}
          </span>

          <span class="mt-1 text-sm uppercase tracking-widest text-primary">
            {CONTENT.encabezado.ciudad}
          </span>
        </div>
      </div>

      <p class="max-w-sm font-light leading-relaxed text-background/70">
        {CONTENT.pie.descripcion}
      </p>

      <!-- Redes Sociales -->
      <div class="flex gap-4">
        <a
          href={CONTENT.redesSociales.facebook}
          aria-label="Facebook"
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-background/10 transition-colors hover:bg-primary hover:text-foreground"
        >
          <Icon name="simple-icons:facebook" size={20} aria-hidden="true" />
        </a>

        <a
          href={CONTENT.redesSociales.instagram}
          aria-label="Instagram"
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-background/10 transition-colors hover:bg-primary hover:text-foreground"
        >
          <Icon name="simple-icons:instagram" size={20} aria-hidden="true" />
        </a>

        <a
          href={CONTENT.redesSociales.youtube}
          aria-label="YouTube"
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-background/10 transition-colors hover:bg-primary hover:text-foreground"
        >
          <Icon name="simple-icons:youtube" size={20} aria-hidden="true" />
        </a>
      </div>
    </div>

    <!-- Enlaces -->
    <div class="space-y-6">
      <h4 class="font-display text-lg text-background">Enlaces</h4>

      <ul class="space-y-3 font-light text-background/80">
        {
          RUTAS_NAVEGACION.map((link) => (
            <li>
              <a href={link.ruta} class="transition-colors hover:text-primary">
                {link.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Contacto -->
    <div class="min-w-0 space-y-6">
      <h4 class="font-display text-lg text-background">Contacto</h4>

      <ul class="space-y-4 font-light text-background/80">
        <li class="flex min-w-0 items-start gap-3">
          <MapPin
            size={20}
            class="mt-0.5 shrink-0 text-primary"
            aria-hidden="true"
          />

          <span class="min-w-0 wrap-break-words">
            {CONTENT.contacto.direccion}
          </span>
        </li>

        <li class="flex items-center gap-3">
          <Phone size={20} class="shrink-0 text-primary" aria-hidden="true" />

          <a
            href={`tel:${CONTENT.contacto.telefono.replace(/\s/g, "")}`}
            class="transition-colors hover:text-primary"
          >
            {CONTENT.contacto.telefono}
          </a>
        </li>

        <li class="flex min-w-0 items-center gap-3">
          <Mail size={20} class="shrink-0 text-primary" aria-hidden="true" />

          <a
            href={`mailto:${CONTENT.contacto.correo}`}
            class="min-w-0 break-all transition-colors hover:text-primary"
          >
            {CONTENT.contacto.correo}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Pie -->
  <div
    class="mx-auto mt-16 flex max-w-7xl flex-col items-center justify-between gap-4 border-t border-background/10 px-6 pt-8 text-sm font-light text-background/50 md:flex-row"
  >
    <p>
      © {new Date().getFullYear()}{" "}
      {CONTENT.encabezado.nombreCompleto}. Todos los derechos reservados.
    </p>

    <div class="flex flex-wrap justify-center gap-6 md:justify-end">
      <a href="#" class="transition-colors hover:text-background">
        {CONTENT.legal.privacidad}
      </a>

      <a href="#" class="transition-colors hover:text-background">
        {CONTENT.legal.terminos}
      </a>
    </div>
  </div>
</footer>
