---
/**
 * Hero de la página "Nosotros".
 *
 * Presenta la identidad espiritual de la comunidad parroquial
 * sin anticipar los datos institucionales que se desarrollan
 * en las siguientes secciones.
 */

import { Image } from "astro:assets";

const heroImage =
  "https://images.unsplash.com/photo-1579975096649-e773152b04cb?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjaHVyY2glMjBjaG9pciUyMHdvcnNoaXAlMjBtb2Rlcm58ZW58MXx8fHwxNzc4ODEzMDcyfDA&ixlib=rb-4.1.0&q=80&w=2000";
---

<section
  aria-labelledby="nosotros-hero-titulo"
  class="relative overflow-hidden rounded-b-[3rem] bg-primary px-6 pb-24 pt-48 text-foreground"
>
  <!-- Imagen de fondo -->
  <div class="absolute inset-0 opacity-20">
    <Image
      src={heroImage}
      alt="Interior de la iglesia"
      width={2000}
      height={1333}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
  </div>

  <!-- Contenido -->
  <div class="relative z-10 mx-auto max-w-4xl text-center">
    <h1
      id="nosotros-hero-titulo"
      class="about-hero-fade-up mb-5 font-display text-4xl font-medium leading-[1.1] text-foreground sm:text-5xl md:text-7xl"
    >
      Nuestra Historia
    </h1>

    <p
      class="about-hero-fade-up mx-auto max-w-2xl text-lg font-light leading-relaxed text-foreground/80 md:text-xl"
      style="--animation-delay: 200ms;"
    >
      Una parroquia construida con la fe y el amor de generaciones, guiada por
      el ejemplo de San Pedro Claver, "esclavo de los esclavos".
    </p>
  </div>
</section>

<style>
  .about-hero-fade-up {
    animation: about-hero-fade-up 0.8s ease-out both;
    animation-delay: var(--animation-delay, 0ms);
  }

  @keyframes about-hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-hero-fade-up {
      animation: none;
    }
  }
</style>
