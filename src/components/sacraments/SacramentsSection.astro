---
/**
 * Sección principal de sacramentos.
 *
 * Presenta los sacramentos disponibles y controla la interacción
 * para mostrar sus requisitos y horarios de forma individual.
 */

import { sacraments } from "@/constants/sacraments";

import SacramentCard from "./SacramentCard.astro";

const SACRAMENTS_SECTION_CONTENT = {
  title: "Los Sacramentos",
  description:
    '"Los sacramentos son signos eficaces de la gracia, instituidos por Cristo y confiados a la Iglesia, por los cuales nos es dispensada la vida divina." (CIC 1131)',
} as const;
---

<section
  aria-labelledby="sacraments-title"
  class="min-h-screen bg-background pb-24 pt-32 text-foreground"
>
  <div class="mx-auto max-w-7xl px-6">
    <!-- Encabezado -->
    <header class="mx-auto mb-12 max-w-3xl text-center">
      <h1
        id="sacraments-title"
        class="font-display text-4xl font-medium leading-tight md:text-5xl"
      >
        {SACRAMENTS_SECTION_CONTENT.title}
      </h1>

      <p
        class="mx-auto mt-5 max-w-2xl text-lg font-light leading-relaxed text-foreground/70"
      >
        {SACRAMENTS_SECTION_CONTENT.description}
      </p>
    </header>

    <!-- Lista de sacramentos -->
    <div
      class="grid grid-cols-1 items-start gap-6 md:grid-cols-2 lg:grid-cols-3"
      data-sacraments
    >
      {
        sacraments.map((sacrament) => (
          <SacramentCard sacrament={sacrament} />
        ))
      }
    </div>
  </div>
</section>

<script>
  // Obtiene todas las tarjetas de sacramentos.
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-sacrament-card]"),
  );

  // Obtiene los elementos interactivos de una tarjeta.
  const getElements = (card: HTMLElement) => ({
    panel: card.querySelector<HTMLElement>("[data-sacrament-panel]"),
    trigger: card.querySelector<HTMLButtonElement>("[data-sacrament-trigger]"),
    chevron: card.querySelector<HTMLElement>("[data-sacrament-chevron]"),
    image: card.querySelector<HTMLElement>("[data-sacrament-image]"),
  });

  // Cierra una tarjeta y restablece su estado visual y de accesibilidad.
  const closeCard = (card: HTMLElement) => {
    const { panel, trigger, chevron, image } = getElements(card);

    if (!panel || !trigger) return;

    panel.classList.remove("grid-rows-[1fr]", "opacity-100");
    panel.classList.add("grid-rows-[0fr]", "opacity-0");

    panel.setAttribute("aria-hidden", "true");
    trigger.setAttribute("aria-expanded", "false");

    chevron?.classList.remove("rotate-180");
    image?.classList.remove("scale-105");
  };

  // Abre una tarjeta y cierra cualquier otra tarjeta abierta.
  const openCard = (card: HTMLElement) => {
    const { panel, trigger, chevron, image } = getElements(card);

    if (!panel || !trigger) return;

    // Solo un sacramento puede permanecer abierto.
    cards.forEach((otherCard) => {
      if (otherCard !== card) {
        closeCard(otherCard);
      }
    });

    panel.classList.remove("grid-rows-[0fr]", "opacity-0");
    panel.classList.add("grid-rows-[1fr]", "opacity-100");

    panel.setAttribute("aria-hidden", "false");
    trigger.setAttribute("aria-expanded", "true");

    chevron?.classList.add("rotate-180");
    image?.classList.add("scale-105");
  };

  // Configura la interacción de apertura y cierre de cada tarjeta.
  cards.forEach((card) => {
    const trigger = card.querySelector<HTMLButtonElement>(
      "[data-sacrament-trigger]",
    );

    if (!trigger) return;

    trigger.addEventListener("click", () => {
      const isOpen = trigger.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        closeCard(card);
      } else {
        openCard(card);
      }
    });
  });

  // Cierra las tarjetas cuando se hace clic fuera de ellas.
  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Node)) return;

    const clickedInsideCard = cards.some((card) => card.contains(target));

    if (!clickedInsideCard) {
      cards.forEach(closeCard);
    }
  });
</script>