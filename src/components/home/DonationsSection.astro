---
/**
 * Sección de donaciones.
 *
 * Presenta diferentes formas de apoyar la obra evangelizadora
 * de la Parroquia San Pedro Claver.
 *
 * Los datos bancarios y de contacto son demostrativos
 * hasta contar con información oficial.
 */

import { Heart, Landmark, Smartphone } from "@lucide/astro";

/**
 * Información de la sección de donaciones.
 *
 * Se mantiene local porque estos datos se utilizan únicamente
 * en esta sección del sitio web.
 */
const DONATIONS_CONTENT = {
  label: "Generosidad que transforma",
  title: "Apoya nuestra obra evangelizadora",
  description:
    "Tu generosidad nos permite mantener nuestro templo, apoyar a quienes más lo necesitan y continuar anunciando el Evangelio y sirviendo a nuestra comunidad parroquial.",
  methods: [
    {
      type: "Donación por celular",
      name: "Nequi",
      number: "320 123 4567",
      holder: "Parroquia San Pedro Claver",
    },
    {
      type: "Transferencia bancaria",
      name: "Bancolombia",
      accountType: "Cuenta de ahorros",
      accountNumber: "123-456789-00",
      taxId: "890.123.456-7",
    },
  ],
} as const;
---

<section
  aria-labelledby="donations-title"
  class="bg-background py-16 text-foreground lg:py-20"
>
  <div class="mx-auto max-w-7xl px-6">
    <!-- Encabezado de la sección -->
    <header class="mx-auto mb-12 max-w-3xl text-center">
      <!-- Icono representativo de la generosidad -->
      <Heart
        size={42}
        stroke-width={1.5}
        class="mx-auto mb-5 text-secondary"
        aria-hidden="true"
      />

      <!-- Texto introductorio -->
      <span class="text-sm font-medium uppercase tracking-wider text-secondary">
        {DONATIONS_CONTENT.label}
      </span>

      <!-- Título de la sección -->
      <h2
        id="donations-title"
        class="mt-2 font-display text-4xl font-medium leading-tight md:text-5xl"
      >
        {DONATIONS_CONTENT.title}
      </h2>

      <!-- Descripción de la finalidad de las donaciones -->
      <p class="mt-5 text-lg font-light leading-relaxed text-foreground/70">
        {DONATIONS_CONTENT.description}
      </p>
    </header>

    <!-- Formas disponibles para realizar donaciones -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2">
      <!-- Donación mediante Nequi -->
      <article
        class="group rounded-2xl border border-foreground/10 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
      >
        <!-- Icono del método de donación -->
        <div
          class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-secondary/15 text-secondary"
        >
          <Smartphone size={26} aria-hidden="true" />
        </div>

        <!-- Tipo de donación -->
        <span
          class="text-sm font-medium uppercase tracking-wide text-secondary"
        >
          {DONATIONS_CONTENT.methods[0].type}
        </span>

        <!-- Nombre del medio de pago -->
        <h3 class="mt-2 font-display text-2xl font-medium">
          {DONATIONS_CONTENT.methods[0].name}
        </h3>

        <!-- Número utilizado para la donación -->
        <p class="mt-4 text-2xl font-medium tracking-wide">
          {DONATIONS_CONTENT.methods[0].number}
        </p>

        <!-- Titular de la cuenta -->
        <p class="mt-2 text-sm text-foreground/60">
          {DONATIONS_CONTENT.methods[0].holder}
        </p>
      </article>

      <!-- Donación mediante transferencia bancaria -->
      <article
        class="group rounded-2xl border border-foreground/10 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
      >
        <!-- Icono del método de donación -->
        <div
          class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-secondary/15 text-secondary"
        >
          <Landmark size={26} aria-hidden="true" />
        </div>

        <!-- Tipo de donación -->
        <span
          class="text-sm font-medium uppercase tracking-wide text-secondary"
        >
          {DONATIONS_CONTENT.methods[1].type}
        </span>

        <!-- Entidad bancaria -->
        <h3 class="mt-2 font-display text-2xl font-medium">
          {DONATIONS_CONTENT.methods[1].name}
        </h3>

        <!-- Tipo de cuenta -->
        <p class="mt-4 text-sm text-foreground/60">
          {DONATIONS_CONTENT.methods[1].accountType}
        </p>

        <!-- Número de cuenta -->
        <p class="mt-1 text-xl font-medium tracking-wide">
          {DONATIONS_CONTENT.methods[1].accountNumber}
        </p>

        <!-- Identificación tributaria -->
        <p class="mt-2 text-sm text-foreground/60">
          NIT: {DONATIONS_CONTENT.methods[1].taxId}
        </p>
      </article>
    </div>
  </div>
</section>
