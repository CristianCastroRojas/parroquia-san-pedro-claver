---
/**
 * Sección de noticias parroquiales.
 *
 * Presenta las noticias más recientes de la comunidad
 * y permite acceder a la publicación completa.
 */

import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";

import { news } from "@/constants/news";

/**
 * Contenido de la sección de noticias.
 *
 * Se mantiene local porque estos datos corresponden
 * únicamente a la presentación de esta sección.
 */
const NEWS_CONTENT = {
  label: "Actualidad",
  title: "Noticias parroquiales",
  description:
    "Conoce las noticias, acontecimientos y momentos que hacen parte de la vida de nuestra comunidad parroquial.",
  allNewsLink: {
    label: "Ver todas",
    ariaLabel: "Ver todas las noticias parroquiales",
    path: "/blog",
  },
  articleLinkLabel: "Leer más",
} as const;
---

<section
  aria-labelledby="news-title"
  class="bg-secondary py-16 text-foreground lg:py-20"
>
  <div class="mx-auto max-w-7xl px-6">
    <!-- Encabezado de la sección -->
    <header
      class="mb-10 flex flex-col gap-6 md:mb-12 md:flex-row md:items-end md:justify-between"
    >
      <div class="max-w-2xl">
        <span
          class="text-sm font-medium uppercase tracking-wider text-foreground/70"
        >
          {NEWS_CONTENT.label}
        </span>

        <!-- Título de la sección -->
        <h2
          id="news-title"
          class="mt-2 font-display text-4xl font-medium leading-tight text-foreground md:text-5xl"
        >
          {NEWS_CONTENT.title}
        </h2>

        <!-- Descripción de la sección -->
        <p class="mt-4 max-w-xl text-base leading-relaxed text-foreground/75">
          {NEWS_CONTENT.description}
        </p>
      </div>

      <!-- Enlace hacia todas las noticias -->
      <a
        href={NEWS_CONTENT.allNewsLink.path}
        aria-label={NEWS_CONTENT.allNewsLink.ariaLabel}
        class="group inline-flex shrink-0 items-center gap-2 font-medium text-foreground transition-colors hover:text-foreground/70"
      >
        {NEWS_CONTENT.allNewsLink.label}

        <ArrowRight
          size={18}
          aria-hidden="true"
          class="transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </header>

    <!-- Lista de noticias -->
    <div
      class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
      role="list"
    >
      {
        news.map((article) => (
          <a
            href={article.path}
            role="listitem"
            class="group flex flex-col overflow-hidden rounded-2xl border border-foreground/10 bg-background shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
          >
            <!-- Imagen de la noticia -->
            <div class="relative aspect-16/10 overflow-hidden">
              <Image
                src={article.image}
                alt={article.altText}
                width={800}
                height={500}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />

              <!-- Capa de contraste sobre la imagen -->
              <div
                class="absolute inset-0 bg-linear-to-t from-foreground/40 to-transparent"
                aria-hidden="true"
              >
              </div>
            </div>

            <!-- Información de la noticia -->
            <div class="flex flex-1 flex-col p-6">
              <!-- Categoría y fecha de publicación -->
              <div class="mb-3 flex flex-wrap items-center gap-3">
                <span
                  class="rounded-full bg-secondary/20 px-3 py-1 text-xs font-medium text-foreground"
                >
                  {article.category}
                </span>

                <span class="text-xs font-medium text-foreground/60">
                  {article.date}
                </span>
              </div>

              <!-- Título de la noticia -->
              <h3
                class="font-display text-xl font-medium leading-snug text-foreground transition-colors group-hover:text-secondary"
              >
                {article.title}
              </h3>

              <!-- Resumen de la noticia -->
              <p
                class="mt-2 line-clamp-3 text-sm leading-relaxed text-foreground/70"
              >
                {article.description}
              </p>

              <!-- Acción posicionada al final de la tarjeta -->
              <span
                class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-medium text-foreground transition-all group-hover:gap-2"
              >
                {NEWS_CONTENT.articleLinkLabel}

                <ArrowRight size={16} aria-hidden="true" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>