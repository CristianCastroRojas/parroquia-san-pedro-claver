---
/**
 * Página principal del sitio web.
 *
 * Presenta las diferentes secciones informativas
 * y de interacción de la Parroquia San Pedro Claver.
 *
 * Las secciones se organizan en el orden en que
 * aparecen dentro de la página de inicio.
 */

import DioceseSection from "@/components/Home/DioceseSection.astro";
import DonationsSection from "@/components/Home/DonationsSection.astro";
import EventsSection from "@/components/Home/EventsSection.astro";
import HeroHomeSection from "@/components/Home/HeroHomeSection.astro";
import LaVerdadSection from "@/components/Home/LaVerdadSection.astro";
import NewsSection from "@/components/Home/NewsSection.astro";
import VoxDeiSection from "@/components/Home/VoxDeiSection.astro";
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="Parroquia San Pedro Claver | Sitio Oficial">
  <!-- Presentación principal -->
  <HeroHomeSection />

  <!-- Emisora de la Diócesis -->
  <VoxDeiSection />

  <!-- Eventos y actividades -->
  <EventsSection />

  <!-- Periódico La Verdad -->
  <LaVerdadSection />

  <!-- Noticias parroquiales -->
  <NewsSection />

  <!-- Donaciones -->
  <DonationsSection />

  <!-- Diócesis de Cúcuta -->
  <DioceseSection />
</MainLayout>
