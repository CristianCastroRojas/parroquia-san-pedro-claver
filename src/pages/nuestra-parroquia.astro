---
/**
 * Página de Nuestra Parroquia.
 *
 * Presenta la identidad, historia, santo patrono y equipo
 * pastoral de la Parroquia San Pedro Claver.
 *
 * Las secciones se organizan en el orden en que
 * aparecen dentro de la página.
 */

import ParishHeroSection from "@/components/parish/ParishHeroSection.astro";
import WhoWeAre from "@/components/parish/WhoWeAre.astro";
import ParishHistory from "@/components/parish/ParishHistory.astro";
import PatronSaint from "@/components/parish/PatronSaint.astro";
import PastoralTeam from "@/components/parish/PastoralTeam.astro";

import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="Parroquia San Pedro Claver | Nuestra Parroquia">
  <!-- Presentación principal -->
  <ParishHeroSection />

  <!-- Quiénes somos -->
  <WhoWeAre />

  <!-- Historia de la parroquia -->
  <ParishHistory />

  <!-- Santo patrono -->
  <PatronSaint />

  <!-- Equipo pastoral -->
  <PastoralTeam />
</MainLayout>